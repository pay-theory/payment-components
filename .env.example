# PayTheory Payment Components - Environment Variables

# Environment routing (used for deployed endpoint URLs)
ENV=your-name
STAGE=paytheorylab
TARGET_MODE=

# Local SDK build/dev mode (webpack dev server + local defaults)
LOCAL_DEV=true

# Hosted endpoint toggles (independent)
LOCAL_HOSTED_FIELDS=false
LOCAL_HOSTED_CHECKOUT=false

# Local hosted endpoints
LOCAL_HOSTED_FIELDS_ENDPOINT=https://localhost:3001
LOCAL_HOSTED_CHECKOUT_ENDPOINT=http://localhost:3002

# PayTheory API Configuration
PAYTHEORY_API_KEY=your-paytheory-api-key

# Google Pay Configuration
GOOGLE_MERCHANT_ID=your-google-merchant-id
GOOGLE_GATEWAY_MERCHANT_ID=your-gateway-merchant-id

# Test Configuration
TEST_AMOUNT=1000
